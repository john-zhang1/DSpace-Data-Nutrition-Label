+import { Injectable } from '@angular/core';
+import {
+  map,
+  Observable,
+} from 'rxjs';
+
+import { ConfigurationDataService } from '../data/configuration-data.service';
+import { RemoteData } from '../data/remote-data';
+import { ConfigurationProperty } from '../shared/configuration-property.model';
+import { getFirstCompletedRemoteData } from '../shared/operators';
+
+/**
+ * Reads the backend Data Nutrition Label master switch (nutrition.label.enable) so the UI can
+ * mirror it: hide the item-page badge, drop the full-item-page nutrition.* rows, and remove the
+ * 'datanutrition' option from the curation-task dropdown when the feature is turned off.
+ *
+ * The property is exposed through rest.properties.exposed. It defaults to enabled when the
+ * property is absent or not readable, matching the backend default (true).
+ */
+@Injectable({
+  providedIn: 'root',
+})
+export class NutritionLabelConfigService {
+
+  static readonly PROPERTY = 'nutrition.label.enable';
+
+  /** Curation-task short name registered for the Data Nutrition Label task. */
+  static readonly TASK_NAME = 'datanutrition';
+
+  constructor(
+    private configService: ConfigurationDataService,
+  ) {
+  }
+
+  /**
+   * Whether the Data Nutrition Label feature is enabled on the backend.
+   */
+  isEnabled(): Observable<boolean> {
+    return this.configService.findByPropertyName(NutritionLabelConfigService.PROPERTY).pipe(
+      getFirstCompletedRemoteData(),
+      map((rd: RemoteData<ConfigurationProperty>) =>
+        !rd.hasSucceeded || rd.payload?.values?.[0] !== 'false'),
+    );
+  }
+}
