+++ b/src/themes/dspace/app/item-page/simple/item-types/untyped-item/nutrition-label/nutrition-label.component.ts
@@ -0,0 +1,57 @@
+import { DatePipe } from '@angular/common';
+import {
+  ChangeDetectionStrategy,
+  Component,
+  Input,
+  OnInit,
+} from '@angular/core';
+import { TranslateModule } from '@ngx-translate/core';
+
+import { Item } from '../../../../../../../../app/core/shared/item.model';
+
+interface NutritionDimension {
+  key: string;
+  value: number;
+}
+
+/**
+ * Compact "Data Nutrition Label" for the item page: a colour-coded grade chip plus a
+ * small breakdown of the scoring dimensions. Reads the nutrition.* metadata written by the
+ * backend NutritionScorer; renders nothing when an item has not been assessed.
+ */
+@Component({
+  selector: 'ds-nutrition-label',
+  styleUrls: ['./nutrition-label.component.scss'],
+  templateUrl: './nutrition-label.component.html',
+  changeDetection: ChangeDetectionStrategy.OnPush,
+  imports: [
+    DatePipe,
+    TranslateModule,
+  ],
+})
+export class NutritionLabelComponent implements OnInit {
+
+  @Input() item: Item;
+
+  grade: string;
+  score: string;
+  assessed: string;
+  dimensions: NutritionDimension[] = [];
+
+  ngOnInit(): void {
+    this.grade = this.item?.firstMetadataValue('nutrition.grade');
+    this.score = this.item?.firstMetadataValue('nutrition.score');
+    this.assessed = this.item?.firstMetadataValue('nutrition.assessed');
+
+    const report = this.item?.firstMetadataValue('nutrition.report');
+    if (report) {
+      try {
+        const parsed = JSON.parse(report);
+        this.dimensions = Object.keys(parsed)
+          .map((key) => ({ key, value: Number(parsed[key]) }));
+      } catch {
+        // leave dimensions empty if the JSON is malformed
+      }
+    }
+  }
+}
