+<?xml version="1.0" encoding="UTF-8"?>
+<!--
+  Data Nutrition Label metadata schema.
+
+  Load once into the registry (the registry lives in the database):
+    [dspace]/bin/dspace registry-loader -metadata [dspace]/config/registries/nutrition-types.xml
+
+  These fields are system-written by NutritionScorer; keep them out of the submission form.
+-->
+<dspace-dc-types>
+
+    <dc-schema>
+        <name>nutrition</name>
+        <namespace>http://dspace.org/namespace/nutrition/</namespace>
+    </dc-schema>
+
+    <dc-type>
+        <schema>nutrition</schema>
+        <element>score</element>
+        <scope_note>Overall quality score, 0-100.</scope_note>
+    </dc-type>
+
+    <dc-type>
+        <schema>nutrition</schema>
+        <element>grade</element>
+        <scope_note>Letter grade A-F derived from the score.</scope_note>
+    </dc-type>
+
+    <dc-type>
+        <schema>nutrition</schema>
+        <element>completeness</element>
+        <scope_note>Completeness sub-score, 0-100.</scope_note>
+    </dc-type>
+
+    <dc-type>
+        <schema>nutrition</schema>
+        <element>report</element>
+        <scope_note>JSON breakdown of all scoring dimensions.</scope_note>
+    </dc-type>
+
+    <dc-type>
+        <schema>nutrition</schema>
+        <element>assessed</element>
+        <scope_note>ISO-8601 timestamp of the last assessment.</scope_note>
+    </dc-type>
+
+    <dc-type>
+        <schema>nutrition</schema>
+        <element>fingerprint</element>
+        <scope_note>SHA-256 of substantive content; drives recursion-safe re-assessment.</scope_note>
+    </dc-type>
+
+</dspace-dc-types>
