From 121fcbe5a6b662e1dcdc37ba102cec7c3a824bc6 Mon Sep 17 00:00:00 2001
From: john-zhang1 <john-zhang1@hotmail.com>
Date: Fri, 24 Jul 2026 21:30:15 -0500
Subject: [PATCH backend 4/4] register the NutritionConsumer and enable it in
 the default dispatcher

Declare event.consumer.nutrition.{class,filters} and add 'nutrition' to
event.dispatcher.default.consumers, and document that a local.cfg which
overrides the consumer list must add 'nutrition' itself.

(split out of commit 903bc927e24ec249d78b519f822c0eed94fe79c8)
---
 dspace/config/dspace.cfg | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/dspace/config/dspace.cfg b/dspace/config/dspace.cfg
index ffe0869..b394796 100644
--- a/dspace/config/dspace.cfg
+++ b/dspace/config/dspace.cfg
@@ -791,11 +791,14 @@ event.dispatcher.default.class = org.dspace.event.BasicDispatcher
 # Add rdf here, if you are using dspace-rdf to export your repository content as RDF.
 # Add iiif here, if you are using dspace-iiif.
 # Add orcidqueue here, if the integration with ORCID is configured and wish to enable the synchronization queue functionality
-event.dispatcher.default.consumers = versioning, discovery, eperson, qaeventsdelete, ldnmessage
+event.dispatcher.default.consumers = versioning, discovery, eperson, qaeventsdelete, ldnmessage, nutrition
 
 # Data Nutrition Label master switch. When false, the NutritionConsumer and the
 # 'datanutrition' curation task become inert (no scoring at archival/edit, no manual runs),
 # and the UI hides the label. Default true; override in local.cfg to disable.
+# Prefer this switch over removing 'nutrition' from the dispatcher list above: any local.cfg
+# that overrides event.dispatcher.default.consumers replaces this line wholesale, so a site
+# maintaining its own consumer list must add 'nutrition' to it explicitly.
 nutrition.label.enable = true
 
 # The noindex dispatcher will not create search or browse indexes (useful for batch item imports)
@@ -846,6 +849,13 @@ event.consumer.orcidqueue.filters = Item+Install|Modify|Modify_Metadata|Delete|R
 event.consumer.ldnmessage.class = org.dspace.app.ldn.LDNMessageConsumer
 event.consumer.ldnmessage.filters = Item+Install
 
+# Data Nutrition Label consumer: scores an item once at archival (Install) and re-scores it on
+# any substantive edit afterwards. Non-archived and in-workflow items are skipped by the
+# consumer itself, and its own metadata write cannot re-trigger it (content fingerprint guard).
+# Governed by nutrition.label.enable above.
+event.consumer.nutrition.class = org.dspace.nutrition.NutritionConsumer
+event.consumer.nutrition.filters = Item+Install|Modify|Modify_Metadata|Add|Remove
+
 # item submission config reload consumer
 # This consumer can be useful for reloading changes made in the item-submission.xml config file,
 # without restarting Tomcat, primarily for adding new collection mappings.
