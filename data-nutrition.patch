+package org.dspace.ctask.nutrition;
+
+import java.io.IOException;
+import java.sql.SQLException;
+
+import org.dspace.authorize.AuthorizeException;
+import org.dspace.content.DSpaceObject;
+import org.dspace.content.Item;
+import org.dspace.core.Constants;
+import org.dspace.curate.AbstractCurationTask;
+import org.dspace.curate.Curator;
+import org.dspace.nutrition.NutritionScorer;
+import org.dspace.services.factory.DSpaceServicesFactory;
+
+/**
+ * Curation task wrapper around {@link NutritionScorer}, for manual and batch use, e.g.:
+ *
+ * <pre>
+ *   [dspace]/bin/dspace curate -t datanutrition -i 123456789/42   # one item
+ *   [dspace]/bin/dspace curate -t datanutrition -i all            # backfill the repository
+ * </pre>
+ *
+ * <p>Automatic assessment (at archival and on edit) is handled by
+ * {@link org.dspace.nutrition.NutritionConsumer}; this task is not wired into
+ * workflow-curation.xml.
+ */
+public class DataNutritionLabel extends AbstractCurationTask {
+
+    private NutritionScorer scorer;
+
+    @Override
+    public void init(Curator curator, String taskId) throws IOException {
+        super.init(curator, taskId);
+        // Tasks aren't Spring beans, so pull the service from the container by name.
+        this.scorer = DSpaceServicesFactory.getInstance().getServiceManager()
+                .getServiceByName(NutritionScorer.class.getName(), NutritionScorer.class);
+    }
+
+    @Override
+    public int perform(DSpaceObject dso) throws IOException {
+        if (dso.getType() != Constants.ITEM) {
+            setResult("Data Nutrition Label applies to items only; skipped.");
+            return Curator.CURATE_SKIP;
+        }
+        Item item = (Item) dso;
+        try {
+            scorer.assessAndWrite(Curator.curationContext(), item);
+            String grade = item.getItemService()
+                    .getMetadataFirstValue(item, "nutrition", "grade", null, Item.ANY);
+            setResult("Data Nutrition grade " + grade + " written for " + item.getHandle());
+            return Curator.CURATE_SUCCESS;
+        } catch (SQLException | AuthorizeException e) {
+            setResult("Error assessing item: " + e.getMessage());
+            return Curator.CURATE_ERROR;
+        }
+    }
+}
diff --git a/dspace-api/src/main/java/org/dspace/nutrition/NutritionConsumer.java b/dspace-api/src/main/java/org/dspace/nutrition/NutritionConsumer.java
new file mode 100644
index 0000000..5b65b37
--- /dev/null
+++ b/dspace-api/src/main/java/org/dspace/nutrition/NutritionConsumer.java
@@ -0,0 +1,131 @@
+package org.dspace.nutrition;
+
+import java.sql.SQLException;
+import java.util.HashSet;
+import java.util.Set;
+import java.util.UUID;
+
+import org.dspace.content.Item;
+import org.dspace.content.factory.ContentServiceFactory;
+import org.dspace.content.service.ItemService;
+import org.dspace.content.service.WorkspaceItemService;
+import org.dspace.core.Constants;
+import org.dspace.core.Context;
+import org.dspace.event.Consumer;
+import org.dspace.event.Event;
+import org.dspace.services.factory.DSpaceServicesFactory;
+import org.dspace.workflow.WorkflowItemService;
+import org.dspace.workflow.factory.WorkflowServiceFactory;
+
+/**
+ * Re-assesses an item's Data Nutrition Label automatically:
+ * <ul>
+ *   <li>once at archival (Item+Install), reflecting the final approved version, and</li>
+ *   <li>on every substantive edit afterwards (Modify / Modify_Metadata / Add / Remove).</li>
+ * </ul>
+ *
+ * <p><b>Recursion guard.</b> {@link NutritionScorer#assessAndWrite} only ever writes
+ * nutrition.* metadata, which is excluded from the content fingerprint. If the current
+ * fingerprint still equals the stored one, the change was our own write (or an admin
+ * editing the label by hand) and is skipped — so the label write cannot re-trigger scoring.
+ *
+ * <p><b>Workflow guard.</b> Drafts and in-review items (in_archive = false, or still
+ * referenced by a workspace/workflow record) are skipped, so reviewer edits during a
+ * multi-step approval don't thrash the scorer before the item is finalized.
+ */
+public class NutritionConsumer implements Consumer {
+
+    private ItemService itemService;
+    private WorkspaceItemService workspaceItemService;
+    private WorkflowItemService workflowItemService;
+    private NutritionScorer scorer;
+
+    // Per-transaction work list. Populated in consume(), drained in end().
+    // Matches DSpace core consumers (e.g. IndexEventConsumer), which use plain
+    // instance fields reset each transaction.
+    private Set<UUID> toProcess;
+
+    @Override
+    public void initialize() throws Exception {
+        itemService = ContentServiceFactory.getInstance().getItemService();
+        workspaceItemService = ContentServiceFactory.getInstance().getWorkspaceItemService();
+        workflowItemService = WorkflowServiceFactory.getInstance().getWorkflowItemService();
+        // Consumers are not Spring beans, so look the service up from the container by name.
+        scorer = DSpaceServicesFactory.getInstance().getServiceManager()
+                .getServiceByName(NutritionScorer.class.getName(), NutritionScorer.class);
+    }
+
+    @Override
+    public void consume(Context ctx, Event event) throws Exception {
+        if (toProcess == null) {
+            toProcess = new HashSet<>();
+        }
+        if (event.getSubjectType() != Constants.ITEM) {
+            return;
+        }
+        UUID itemId = event.getSubjectID();
+        if (itemId == null || toProcess.contains(itemId)) {
+            return;                              // null subject, or already queued this transaction
+        }
+
+        Item item = (Item) event.getSubject(ctx);
+        if (item == null || item.isWithdrawn()) {
+            return;
+        }
+
+        // ---- Workflow guard -------------------------------------------------------------
+        // Cheap skip: drafts and in-review items have in_archive = false.
+        if (!item.isArchived()) {
+            return;
+        }
+        // Explicit, intent-documenting backstop (also survives the check above being
+        // loosened later, and the rare archived-but-still-in-flux edge).
+        if (inSubmissionOrWorkflow(ctx, item)) {
+            return;
+        }
+
+        // ---- Recursion guard ------------------------------------------------------------
+        // Stored fingerprint is null on a never-assessed item, so first-time items
+        // (including freshly archived ones via Install) fall through and get queued.
+        String current = scorer.computeFingerprint(ctx, item);
+        String stored = itemService.getMetadataFirstValue(item, "nutrition", "fingerprint", null, Item.ANY);
+        if (current.equals(stored)) {
+            return;
+        }
+
+        toProcess.add(itemId);
+    }
+
+    @Override
+    public void end(Context ctx) throws Exception {
+        if (toProcess == null) {
+            return;
+        }
+        for (UUID id : toProcess) {
+            Item item = itemService.find(ctx, id);
+            if (item != null && item.isArchived() && !item.isWithdrawn()) {
+                // The triggering user may lack write rights; the label is a system
+                // annotation, so elevate just for this write.
+                ctx.turnOffAuthorisationSystem();
+                try {
+                    scorer.assessAndWrite(ctx, item);
+                } finally {
+                    ctx.restoreAuthSystemState();
+                }
+            }
+        }
+        toProcess.clear();
+        toProcess = null;                        // reset for the next transaction
+    }
+
+    @Override
+    public void finish(Context ctx) throws Exception {
+        // No external resources to release.
+    }
+
+    /** True while the item is still in submission or mid-approval (not a finalized, archived item). */
+    private boolean inSubmissionOrWorkflow(Context ctx, Item item) throws SQLException {
+        return workspaceItemService.findByItem(ctx, item) != null
+                || workflowItemService.findByItem(ctx, item) != null;
+    }
+}
diff --git a/dspace-api/src/main/java/org/dspace/nutrition/NutritionScorer.java b/dspace-api/src/main/java/org/dspace/nutrition/NutritionScorer.java
new file mode 100644
index 0000000..5cded5c
--- /dev/null
+++ b/dspace-api/src/main/java/org/dspace/nutrition/NutritionScorer.java
@@ -0,0 +1,35 @@
+package org.dspace.nutrition;
+
+import java.io.IOException;
+import java.sql.SQLException;
+
+import org.dspace.authorize.AuthorizeException;
+import org.dspace.content.Item;
+import org.dspace.core.Context;
+
+/**
+ * Computes the "Data Nutrition Label" for an item and persists it as nutrition.* metadata.
+ *
+ * <p>Shared by both entry points so the submission/archival path and the edit path run
+ * identical logic:
+ * <ul>
+ *   <li>{@link org.dspace.ctask.nutrition.DataNutritionLabel} (curation task, for manual/batch runs)</li>
+ *   <li>{@link NutritionConsumer} (event consumer, for archival + post-archive edits)</li>
+ * </ul>
+ */
+public interface NutritionScorer {
+
+    /**
+     * Assess the item across all dimensions and write nutrition.score, nutrition.grade,
+     * nutrition.completeness, nutrition.report, nutrition.assessed and nutrition.fingerprint
+     * in a single update.
+     */
+    void assessAndWrite(Context ctx, Item item) throws SQLException, IOException, AuthorizeException;
+
+    /**
+     * A stable hash of the item's substantive content — all metadata EXCEPT the nutrition
+     * schema, plus bitstream formats/sizes. Excluding the nutrition schema is what makes the
+     * re-assessment loop terminate: writing the label cannot change this value.
+     */
+    String computeFingerprint(Context ctx, Item item) throws SQLException;
+}
diff --git a/dspace-api/src/main/java/org/dspace/nutrition/NutritionScorerImpl.java b/dspace-api/src/main/java/org/dspace/nutrition/NutritionScorerImpl.java
new file mode 100644
index 0000000..e8e1c5d
--- /dev/null
+++ b/dspace-api/src/main/java/org/dspace/nutrition/NutritionScorerImpl.java
@@ -0,0 +1,177 @@
+package org.dspace.nutrition;
+
+import java.io.IOException;
+import java.sql.SQLException;
+import java.time.Instant;
+import java.util.Arrays;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+import org.apache.commons.codec.digest.DigestUtils;
+import org.dspace.authorize.AuthorizeException;
+import org.dspace.content.Bitstream;
+import org.dspace.content.Bundle;
+import org.dspace.content.Item;
+import org.dspace.content.MetadataField;
+import org.dspace.content.MetadataValue;
+import org.dspace.content.factory.ContentServiceFactory;
+import org.dspace.content.service.ItemService;
+import org.dspace.core.Context;
+
+/**
+ * Default {@link NutritionScorer}. Registered as a Spring bean in
+ * config/spring/api/nutrition.xml under the interface's fully-qualified name so that the
+ * (non-Spring) consumer and curation task can look it up via the service manager.
+ *
+ * <p>The scoring rubric below is a starting set — tune the dimensions and weighting to
+ * reflect what your repository considers "good data".
+ */
+public class NutritionScorerImpl implements NutritionScorer {
+
+    private final ItemService itemService = ContentServiceFactory.getInstance().getItemService();
+    private final ObjectMapper mapper = new ObjectMapper();
+
+    /** Open / archival-friendly formats earn full marks on the openness dimension. */
+    private static final Set<String> OPEN_FORMATS = new HashSet<>(Arrays.asList(
+            "text/csv", "application/json", "text/plain", "text/xml",
+            "application/xml", "application/pdf", "image/png", "image/tiff"));
+
+    @Override
+    public void assessAndWrite(Context ctx, Item item)
+            throws SQLException, IOException, AuthorizeException {
+
+        Map<String, Integer> dims = new LinkedHashMap<>();
+        dims.put("completeness", scoreCompleteness(item));
+        dims.put("licensing",    scoreLicensing(item));
+        dims.put("openness",     scoreOpenness(ctx, item));
+        dims.put("provenance",   scoreProvenance(item));
+
+        int score = (int) Math.round(
+                dims.values().stream().mapToInt(Integer::intValue).average().orElse(0));
+        String grade = letterGrade(score);
+        String fingerprint = computeFingerprint(ctx, item);
+
+        // Clear the whole nutrition schema first so re-runs don't stack values.
+        itemService.clearMetadata(ctx, item, "nutrition", Item.ANY, Item.ANY, Item.ANY);
+        itemService.addMetadata(ctx, item, "nutrition", "score", null, null, String.valueOf(score));
+        itemService.addMetadata(ctx, item, "nutrition", "grade", null, null, grade);
+        itemService.addMetadata(ctx, item, "nutrition", "completeness", null, null,
+                String.valueOf(dims.get("completeness")));
+        itemService.addMetadata(ctx, item, "nutrition", "report", null, null,
+                mapper.writeValueAsString(dims));
+        itemService.addMetadata(ctx, item, "nutrition", "assessed", null, null, Instant.now().toString());
+        itemService.addMetadata(ctx, item, "nutrition", "fingerprint", null, null, fingerprint);
+        itemService.update(ctx, item);
+    }
+
+    @Override
+    public String computeFingerprint(Context ctx, Item item) throws SQLException {
+        StringBuilder sb = new StringBuilder();
+
+        // 1. Every metadata value EXCEPT the nutrition schema, in a stable order.
+        itemService.getMetadata(item, Item.ANY, Item.ANY, Item.ANY, Item.ANY).stream()
+                .filter(v -> !"nutrition".equals(v.getMetadataField().getMetadataSchema().getName()))
+                .map(v -> {
+                    MetadataField f = v.getMetadataField();
+                    String key = f.getMetadataSchema().getName() + "." + f.getElement()
+                            + (f.getQualifier() != null ? "." + f.getQualifier() : "");
+                    return key + "=" + v.getValue();
+                })
+                .sorted()
+                .forEach(s -> sb.append(s).append('\n'));
+
+        // 2. Bitstream formats/sizes in ORIGINAL, so a file swap also invalidates the label.
+        for (Bundle b : item.getBundles("ORIGINAL")) {
+            for (Bitstream bs : b.getBitstreams()) {
+                sb.append("bs:").append(bs.getFormat(ctx).getMIMEType())
+                        .append(':').append(bs.getSizeBytes()).append('\n');
+            }
+        }
+        return DigestUtils.sha256Hex(sb.toString());
+    }
+
+    // ---- Scoring dimensions (0-100 each) ------------------------------------------------
+
+    /** Required + recommended Dublin Core fields present. */
+    private int scoreCompleteness(Item item) {
+        String[] required = {"dc.title", "dc.contributor.author", "dc.date.issued", "dc.type"};
+        String[] recommended = {"dc.description.abstract", "dc.subject", "dc.language.iso",
+                "dc.publisher", "dc.identifier"};
+        int got = 0;
+        int total = required.length + recommended.length;
+        for (String f : required) {
+            if (hasValue(item, f)) {
+                got++;
+            }
+        }
+        for (String f : recommended) {
+            if (hasValue(item, f)) {
+                got++;
+            }
+        }
+        return (got * 100) / total;
+    }
+
+    /** A clear rights/license statement. */
+    private int scoreLicensing(Item item) {
+        return (hasValue(item, "dc.rights") || hasValue(item, "dc.rights.uri")) ? 100 : 0;
+    }
+
+    /** Share of ORIGINAL-bundle bitstreams in open/archival formats. */
+    private int scoreOpenness(Context ctx, Item item) throws SQLException {
+        int open = 0;
+        int total = 0;
+        for (Bundle b : item.getBundles("ORIGINAL")) {
+            for (Bitstream bs : b.getBitstreams()) {
+                total++;
+                if (OPEN_FORMATS.contains(bs.getFormat(ctx).getMIMEType())) {
+                    open++;
+                }
+            }
+        }
+        return total == 0 ? 0 : (open * 100) / total;
+    }
+
+    /** Persistent identifiers and funding/sponsorship provenance. */
+    private int scoreProvenance(Item item) {
+        int got = 0;
+        if (hasValue(item, "dc.identifier.uri")) {
+            got += 50;
+        }
+        if (hasValue(item, "dc.relation.funding") || hasValue(item, "dc.description.sponsorship")) {
+            got += 50;
+        }
+        return got;
+    }
+
+    // ---- Helpers ------------------------------------------------------------------------
+
+    private boolean hasValue(Item item, String field) {
+        String[] p = field.split("\\.", 3);
+        String schema = p[0];
+        String element = p[1];
+        String qualifier = (p.length == 3) ? p[2] : null;
+        List<MetadataValue> vals = itemService.getMetadata(item, schema, element, qualifier, Item.ANY);
+        return vals.stream().anyMatch(v -> v.getValue() != null && !v.getValue().isBlank());
+    }
+
+    private String letterGrade(int s) {
+        if (s >= 90) {
+            return "A";
+        }
+        if (s >= 75) {
+            return "B";
+        }
+        if (s >= 60) {
+            return "C";
+        }
+        if (s >= 40) {
+            return "D";
+        }
+        return "F";
+    }
+}
